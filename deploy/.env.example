# Settings for deploy/compose.yaml. Copy to deploy/.env and replace every "change-me" value.
#   cp .env.example .env
# Never commit deploy/.env or share it: it holds your passwords.
# Generate random values with:  openssl rand -hex 32
# (letters and digits only, so they are safe inside the database address).

# Database. The password protects all your data.
POSTGRES_USER=personal_os
POSTGRES_PASSWORD=change-me-database-password
POSTGRES_DB=personal_os

# Sign-in. The secret must be at least 32 characters.
BETTER_AUTH_SECRET=change-me-to-a-random-value-of-at-least-32-characters
# The address you open in the browser (must match exactly, including the port).
BETTER_AUTH_URL=http://localhost:3000
# Port on this computer. Change both this and BETTER_AUTH_URL if 3000 is taken.
APP_PORT=3000
# Set to false after you have registered your own account, so nobody else can sign up.
AUTH_ALLOW_SIGNUP=true

# Automation worker: runs scheduled rules and the 自制力 overdue check every minute.
# At least 32 characters. Leave empty to switch scheduled rules off.
AUTOMATION_WORKER_SECRET=change-me-to-another-random-value-of-32-characters
