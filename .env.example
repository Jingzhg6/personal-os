# Copy to .env.local:  cp .env.example .env.local

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://personal_os:personal_os@localhost:5433/personal_os
TEST_DATABASE_URL=postgres://personal_os:personal_os@localhost:5433/personal_os_test

# Better Auth — generate a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# Set to "false" to close sign-up after creating your own account.
AUTH_ALLOW_SIGNUP=true
